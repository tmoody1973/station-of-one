{
  // Starts the hourly newscast build on the Sprite. Replaced GitHub's schedule, which skipped
  // its 1:48 and 2:48 pm slots on Nov 26 (docs/decisions/005-cloudflare-trigger.md).
  "name": "station-one-trigger",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,  // no public URL: the Worker only runs on its schedule
  "triggers": {
    // Every hour at :48 (UTC). In newscast hours (7 am-7 pm Central) the Sprite builds the newscast, then the
    // music stations; outside them it runs only the 24/7 music stations (plan B1, decision 009), no newscast.
    "crons": ["48 * * * *"]
  }
  // Secret SPRITES_TOKEN is set with `npx wrangler secret put SPRITES_TOKEN`; it is never in this repo.
}
